function(kenzo_embed_assets OUTPUT)
    cmake_parse_arguments(ARG "" "" "MARKUP;STYLE" ${ARGN})

    set(body "// generated by EmbedAssets.cmake\n#include \"ui/assets.hpp\"\n\nnamespace kenzo::ui::embedded {\n")
    foreach(kind MARKUP STYLE)
        string(TOLOWER ${kind} kind_lower)
        set(chunks "")
        set(count 0)
        foreach(file IN LISTS ARG_${kind})
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
            file(READ "${file}" text)
            string(LENGTH "${text}" length)
            set(offset 0)
            while(offset LESS length)
                math(EXPR remaining "${length} - ${offset}")
                if(remaining GREATER 3000)
                    set(remaining 3000)
                endif()
                string(SUBSTRING "${text}" ${offset} ${remaining} piece)
                math(EXPR piece_end "${offset} + ${remaining}")
                if(remaining EQUAL 3000 AND piece_end LESS length)
                    string(FIND "${piece}" "\n" last_break REVERSE)
                    if(last_break GREATER 0)
                        math(EXPR remaining "${last_break} + 1")
                        string(SUBSTRING "${text}" ${offset} ${remaining} piece)
                    endif()
                endif()
                string(APPEND chunks "    R\"kz(${piece})kz\",\n")
                math(EXPR offset "${offset} + ${remaining}")
                math(EXPR count "${count} + 1")
            endwhile()
        endforeach()
        string(APPEND body "extern const std::string_view ${kind_lower}Chunks[] = {\n${chunks}};\nextern const std::size_t ${kind_lower}Count = ${count};\n\n")
    endforeach()
    string(APPEND body "}  // namespace kenzo::ui::embedded\n")

    file(WRITE "${OUTPUT}.tmp" "${body}")
    execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}")
endfunction()
