{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    { "name": "win-debug", "inherits": "base", "generator": "Visual Studio 18 2026", "architecture": "x64", "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-windows-static" } },
    { "name": "win-release", "inherits": "base", "generator": "Visual Studio 18 2026", "architecture": "x64", "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-windows-static" } },
    { "name": "unix-debug", "inherits": "base", "generator": "Ninja", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "unix-release", "inherits": "base", "generator": "Ninja", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } }
  ],
  "buildPresets": [
    { "name": "win-debug", "configurePreset": "win-debug", "configuration": "Debug" },
    { "name": "win-release", "configurePreset": "win-release", "configuration": "Release" },
    { "name": "unix-debug", "configurePreset": "unix-debug" },
    { "name": "unix-release", "configurePreset": "unix-release" }
  ]
}
